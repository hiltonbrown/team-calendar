diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
new file mode 100644
index 0000000..c57cd51
--- /dev/null
+++ b/.github/workflows/release.yml
@@ -0,0 +1,156 @@
+# Bootstrap prerequisites: merge the referenced release helpers to main, create
+# protected branch release/go-live, and configure approval plus branch rules on
+# the production-release environment before enabling this workflow.
+name: Protected production release
+
+on:
+  workflow_dispatch:
+    inputs:
+      candidate_sha:
+        description: Full reviewed commit SHA from release/go-live
+        required: true
+        type: string
+      recover_interrupted_run:
+        default: false
+        description: Resume the same manifest run after inspecting an interruption
+        required: true
+        type: boolean
+
+permissions:
+  contents: read
+
+concurrency:
+  group: production-release
+  cancel-in-progress: false
+
+jobs:
+  release:
+    name: Migrate and run protected live gates
+    environment: production-release
+    runs-on: ubuntu-latest
+    steps:
+      - name: Check out trusted release tooling
+        uses: actions/checkout@v7
+        with:
+          fetch-depth: 1
+          path: trusted
+          ref: main
+      - name: Verify reviewed release branch SHA
+        working-directory: trusted
+        env:
+          CANDIDATE_SHA: ${{ inputs.candidate_sha }}
+        run: |
+          if [[ ! "$CANDIDATE_SHA" =~ ^[0-9a-f]{40}$ ]]; then
+            echo "candidate_sha must be a full lowercase Git SHA" >&2
+            exit 1
+          fi
+          reviewed_sha=$(git ls-remote origin refs/heads/release/go-live | cut -f1)
+          if [[ -z "$reviewed_sha" || "$reviewed_sha" != "$CANDIDATE_SHA" ]]; then
+            echo "candidate_sha is not the current release/go-live head" >&2
+            exit 1
+          fi
+      - uses: oven-sh/setup-bun@v2
+        with:
+          bun-version-file: trusted/package.json
+      - uses: actions/setup-node@v6
+        with:
+          node-version: 24.21.0
+      - name: Install trusted release tooling
+        working-directory: trusted
+        run: bun install --frozen-lockfile
+      - name: Write candidate-bound protected manifest
+        id: manifest
+        working-directory: trusted
+        env:
+          CANDIDATE_SHA: ${{ inputs.candidate_sha }}
+          TC_PROTECTED_MANIFEST_BASE64: ${{ secrets.TC_PROTECTED_MANIFEST_BASE64 }}
+        run: |
+          manifest_path="$RUNNER_TEMP/team-calendar-release-manifest.json"
+          bun run tooling/release/write-protected-manifest.ts --output "$manifest_path" --candidate-sha "$CANDIDATE_SHA"
+          echo "path=$manifest_path" >> "$GITHUB_OUTPUT"
+          echo "run_id=$(jq -r .runId "$manifest_path")" >> "$GITHUB_OUTPUT"
+      - name: Check out reviewed candidate
+        uses: actions/checkout@v7
+        with:
+          fetch-depth: 0
+          path: candidate
+          ref: ${{ inputs.candidate_sha }}
+      - name: Install candidate dependencies
+        working-directory: candidate
+        run: bun install --frozen-lockfile
+      - name: Verify immutable and ordered migrations
+        working-directory: candidate
+        run: |
+          git fetch --no-tags origin main
+          trusted_base=$(git merge-base HEAD origin/main)
+          bun run tooling/release/migration-check.ts --base "$trusted_base"
+      - name: Verify live target and acquire release fence
+        id: fence
+        working-directory: candidate
+        env:
+          ALLOW_LIVE_DATABASE_TESTS: I_ACKNOWLEDGE_LIVE_MUTATION
+          DATABASE_URL: ${{ secrets.DATABASE_URL }}
+          KV_REST_API_TOKEN: ${{ secrets.KV_REST_API_TOKEN }}
+          KV_REST_API_URL: ${{ secrets.KV_REST_API_URL }}
+          RECOVER_INTERRUPTED_RUN: ${{ inputs.recover_interrupted_run }}
+          TC_RELEASE_RUN_ID: ${{ steps.manifest.outputs.run_id }}
+        run: |
+          recovery_args=()
+          if [[ "$RECOVER_INTERRUPTED_RUN" == "true" ]]; then
+            recovery_args+=(--recover)
+          fi
+          bun run tooling/release/verify-live-target.ts --manifest "${{ steps.manifest.outputs.path }}" "${recovery_args[@]}"
+          echo "acquired=true" >> "$GITHUB_OUTPUT"
+      - name: Reconcile requested interrupted run
+        if: ${{ inputs.recover_interrupted_run }}
+        working-directory: candidate
+        env:
+          ALLOW_LIVE_DATABASE_TESTS: I_ACKNOWLEDGE_LIVE_MUTATION
+          DATABASE_URL: ${{ secrets.DATABASE_URL }}
+          KV_REST_API_TOKEN: ${{ secrets.KV_REST_API_TOKEN }}
+          KV_REST_API_URL: ${{ secrets.KV_REST_API_URL }}
+          TC_RELEASE_RUN_ID: ${{ steps.manifest.outputs.run_id }}
+        run: bun run tooling/release/run-live-integration.ts --manifest "${{ steps.manifest.outputs.path }}" --recover
+      - name: Deploy reviewed migrations
+        if: ${{ !inputs.recover_interrupted_run }}
+        working-directory: candidate
+        env:
+          DATABASE_URL: ${{ secrets.DATABASE_URL }}
+        run: bun run migrate:deploy
+      - name: Verify deployed schema has no drift
+        if: ${{ !inputs.recover_interrupted_run }}
+        working-directory: candidate/packages/database
+        env:
+          DATABASE_URL: ${{ secrets.DATABASE_URL }}
+        run: bunx prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code
+      - name: Run protected live integration gates
+        id: live
+        if: ${{ !inputs.recover_interrupted_run }}
+        working-directory: candidate
+        env:
+          ALLOW_LIVE_DATABASE_TESTS: I_ACKNOWLEDGE_LIVE_MUTATION
+          CLERK_SECRET_KEY: ${{ secrets.CLERK_SECRET_KEY }}
+          DATABASE_URL: ${{ secrets.DATABASE_URL }}
+          INNGEST_EVENT_KEY: ${{ secrets.INNGEST_EVENT_KEY }}
+          INNGEST_SIGNING_KEY: ${{ secrets.INNGEST_SIGNING_KEY }}
+          KV_REST_API_TOKEN: ${{ secrets.KV_REST_API_TOKEN }}
+          KV_REST_API_URL: ${{ secrets.KV_REST_API_URL }}
+          RESEND_FROM: ${{ secrets.RESEND_FROM }}
+          RESEND_TOKEN: ${{ secrets.RESEND_TOKEN }}
+          STRIPE_SECRET_KEY: ${{ secrets.STRIPE_SECRET_KEY }}
+          STRIPE_WEBHOOK_SECRET: ${{ secrets.STRIPE_WEBHOOK_SECRET }}
+          TC_RELEASE_RUN_ID: ${{ steps.manifest.outputs.run_id }}
+          XERO_CLIENT_ID: ${{ secrets.XERO_CLIENT_ID }}
+          XERO_CLIENT_SECRET: ${{ secrets.XERO_CLIENT_SECRET }}
+          XERO_TOKEN_ENCRYPTION_KEY: ${{ secrets.XERO_TOKEN_ENCRYPTION_KEY }}
+        run: bun run tooling/release/run-live-integration.ts --manifest "${{ steps.manifest.outputs.path }}" --preacquired
+      - name: Reconcile a failed or interrupted protected run
+        if: ${{ always() && steps.fence.outputs.acquired == 'true' && steps.live.outcome != 'success' }}
+        working-directory: candidate
+        env:
+          ALLOW_LIVE_DATABASE_TESTS: I_ACKNOWLEDGE_LIVE_MUTATION
+          DATABASE_URL: ${{ secrets.DATABASE_URL }}
+          KV_REST_API_TOKEN: ${{ secrets.KV_REST_API_TOKEN }}
+          KV_REST_API_URL: ${{ secrets.KV_REST_API_URL }}
+          TC_RELEASE_RUN_ID: ${{ steps.manifest.outputs.run_id }}
+        run: bun run tooling/release/run-live-integration.ts --manifest "${{ steps.manifest.outputs.path }}" --recover-if-owned
