# Team Calendar app (authenticated product UI, port 3000).
#
# Copy to apps/app/.env.local and fill in the values you need.
#
# Optional variables with a format rule (URL, email, prefix) are commented out:
# leave them absent rather than set to "". Production requirements are enforced
# by `bun run preflight app`; see the matrix in README.md.

# --- Database (required) ---
# Migration owner connection string (Neon pooled). Use the same database as
# apps/api.
DATABASE_URL=""
# Restricted team_calendar_app connection to the same database. Tenant data is
# read and written through this role under row-level security, so tenant pages
# fail without it. Required in production. Locally, enable the role with
# `bun packages/database/scripts/provision-local-app-role.ts` (local databases
# only). Leave absent, not "", until configured.
# DATABASE_APP_URL="postgresql://team_calendar_app:password@localhost:5432/team-calendar"

# --- Authentication ---
# Keep Clerk selected until the Better Auth server/UI cutover is approved.
AUTH_PROVIDER="clerk"
AUTH_CONTEXT_MODE="local"
# Clerk configuration, required while AUTH_PROVIDER="clerk".
# Required to sign in. Webhooks are received by apps/api, not this app.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
# CLERK_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"

# Better Auth server, required only when AUTH_PROVIDER="better-auth".
# Uses DATABASE_URL (owner connection); never DATABASE_APP_URL.
# Generate a separate environment secret with `openssl rand -base64 48`.
# BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
# Exact app origin: production https://app.teamcalendar.online; Preview uses
# its exact paired app origin, with no wildcard and no /api/auth suffix.
# BETTER_AUTH_URL="http://localhost:3000"
# GOOGLE_CLIENT_ID="google-client-id"
# GOOGLE_CLIENT_SECRET="google-client-secret"
# MICROSOFT_CLIENT_ID="microsoft-client-id"
# MICROSOFT_CLIENT_SECRET="microsoft-client-secret"
# Multi-tenant Entra work/school accounts only.
MICROSOFT_TENANT_ID="organizations"
# A NEW, identity-only Xero app using OIDC scopes. Never reuse the payroll
# XERO_CLIENT_ID or XERO_CLIENT_SECRET below. Sign-in callback is on this app.
# XERO_AUTH_CLIENT_ID="separate-xero-sign-in-client-id"
# XERO_AUTH_CLIENT_SECRET="separate-xero-sign-in-client-secret"
# Keep disabled pending the documented Infrastructure residency/security review.
BETTER_AUTH_INFRA_ENABLED="false"
# BETTER_AUTH_API_KEY="private-infrastructure-api-key"
BETTER_AUTH_TELEMETRY="0"

# --- Public URLs ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WEB_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3002"
# Preview only: set all public URLs to the exact paired deployments. Both
# candidate origins are required and must match their public URL above.
# TC_APP_CANDIDATE_URL="https://app-candidate.vercel.app"
# TC_API_CANDIDATE_URL="https://api-candidate.vercel.app"

# --- Launch mode ---
# "early_access" or "paid". Required in production; development falls back to
# early_access when unset.
# NEXT_PUBLIC_LAUNCH_MODE="early_access"

# --- Xero (required for build) ---
# AES-256-GCM key for Xero tokens at rest: 32 bytes, base64-encoded. Generate
# with `openssl rand -base64 32`. Must be identical in apps/app and apps/api,
# because both read the same encrypted authorisations.
XERO_TOKEN_ENCRYPTION_KEY=""
# Key rotation: new envelopes use ACTIVE_VERSION; keep every version still
# referenced by stored tokens in KEYS_JSON. Version 1 is XERO_TOKEN_ENCRYPTION_KEY.
# XERO_TOKEN_ENCRYPTION_ACTIVE_VERSION="2"
# XERO_TOKEN_ENCRYPTION_KEYS_JSON='{"2":"<base64 32-byte key>"}'
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""
# Commercial tier: starter (1,000 calls/day), or core, plus, advanced or
# enterprise (5,000/day). Required in production; development assumes starter.
# XERO_APP_TIER="starter"
# Exact callback registered on the Xero app, served by apps/api. Required in
# production. Leave unset locally to derive it from NEXT_PUBLIC_API_URL.
# XERO_REDIRECT_URI="https://api.example.com/api/xero/oauth/callback"
# Testing only: override the Xero API origin.
# XERO_API_BASE_URL="https://api.xero.com"

# --- Background jobs (Inngest) ---
# This app dispatches sync events (initial Xero import, balance refresh).
# Locally, send them to the Inngest Dev Server started by `bun run dev`.
INNGEST_DEV="1"
# Deployed environments: set both keys together and remove INNGEST_DEV.
# INNGEST_EVENT_KEY="xxx"
# INNGEST_SIGNING_KEY="signkey-prod-xxx"

# --- Shared KV (feed cache, notification SSE, Xero quota store) ---
# Set both or neither; a partial pair fails at startup. Required in production:
# Xero calls are refused without the shared quota store.
# KV_REST_API_URL="https://example.kv.vercel-storage.com"
# KV_REST_API_TOKEN="xxx"

# --- Email (Resend) ---
# RESEND_TOKEN="re_xxx"
# RESEND_FROM="noreply@example.com"

# --- Billing (Stripe) ---
# Required only when NEXT_PUBLIC_LAUNCH_MODE="paid".
# STRIPE_SECRET_KEY="sk_test_xxx"
# STRIPE_PRICE_BASIC="price_xxx"
# STRIPE_PRICE_PREMIUM="price_xxx"
# STRIPE_PORTAL_RETURN_URL="http://localhost:3000/settings/billing"
# STRIPE_CHECKOUT_SUCCESS_URL="http://localhost:3000/settings/billing"
# STRIPE_CHECKOUT_CANCEL_URL="http://localhost:3000/settings/billing"

# --- Analytics (optional) ---
# NEXT_PUBLIC_POSTHOG_KEY="phc_xxx"
# NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXX"

# --- Observability (Sentry) ---
# Required in production; the Sentry Vercel integration can manage these.
# NEXT_PUBLIC_SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
# SENTRY_ORG="your-sentry-org"
# SENTRY_PROJECT="your-sentry-project"
# SENTRY_AUTH_TOKEN="provider-managed-secret"

# --- Development flags (optional) ---
# Shows the "Beta feature now available" banner in the authenticated layout.
# SHOW_BETA_FEATURE="true"
