    "@repo/feeds": "*",
    "@repo/jobs": "*",
    "@repo/next-config": "*",
    "@repo/notifications": "*",
    "@repo/observability": "*",
    "@repo/seo": "*",
    "@repo/xero": "*",
    "@sentry/nextjs": "^11.13.0",
