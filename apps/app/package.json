{
  "name": "app",
  "private": true,
  "scripts": {
    "analyze": "ANALYZE=true npm run build",
    "build": "next build",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "bun --bun next dev -p 3000",
    "start": "bun --bun next start",
    "test": "NODE_ENV=test vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "ALLOW_LOCAL_DATABASE_TESTS=1 NODE_ENV=test vitest run --config vitest.integration.config.mts .integration.test.ts",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.0",
    "@repo/analytics": "*",
    "@repo/auth": "*",
    "@repo/availability": "*",
    "@repo/billing": "*",
    "@repo/core": "*",
    "@repo/database": "*",
    "@repo/design-system": "*",
    "@repo/email": "*",
    "@repo/feeds": "*",
    "@repo/jobs": "*",
    "@repo/next-config": "*",
    "@repo/notifications": "*",
    "@repo/observability": "*",
    "@repo/seo": "*",
    "@repo/xero": "*",
    "@sentry/nextjs": "^11.9.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "import-in-the-middle": "^3.5.2",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.10.1",
    "require-in-the-middle": "8.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
