# Team Calendar web (public marketing site, port 3001).
#
# Copy to apps/web/.env.local. Nothing here is required for local
# development. This app needs no database, Better Auth, Xero, Inngest or KV values.
#
# Optional variables with a format rule (URL, email, prefix) are commented out:
# leave them absent rather than set to "". Production requirements are enforced
# by `bun run preflight web`; see the matrix in README.md.

# --- Public URLs ---
# NEXT_PUBLIC_WEB_URL is the canonical origin for metadata, robots and sitemap.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WEB_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3002"

# --- Launch mode ---
# Controls pricing page and call-to-action behaviour. "early_access" or "paid".
# Required in production; development falls back to early_access when unset.
# NEXT_PUBLIC_LAUNCH_MODE="early_access"

# --- Public status page (Better Stack, optional) ---
# Server-only. Set all three together; the status page shows Unknown otherwise.
# BETTERSTACK_API_KEY="replace-with-provider-token"
# BETTERSTACK_STATUS_PAGE_ID="replace-with-status-page-id"
# BETTERSTACK_STATUS_PAGE_URL="https://status.example.com"

# --- Analytics (optional) ---
# NEXT_PUBLIC_POSTHOG_KEY="phc_xxx"
# NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXX"

# --- Observability (Sentry) ---
# Required in production; the Sentry Vercel integration can manage these.
# NEXT_PUBLIC_SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
# SENTRY_ORG="your-sentry-org"
# SENTRY_PROJECT="your-sentry-project"
# SENTRY_AUTH_TOKEN="provider-managed-secret"
