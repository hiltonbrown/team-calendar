# Team Calendar web (public marketing site) environment variables.
#
# Copy this file to .env.local and fill in the values you need. Optional
# variables with a format constraint (a URL, an email, or a required prefix)
# are commented out on purpose: an empty string fails Zod format validation
# even for an optional field, so leave them absent rather than set to "".

# --- Public URLs (shared across apps) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WEB_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3002"
NEXT_PUBLIC_DOCS_URL="http://localhost:3004"
# Set automatically by Vercel in deployed environments.
VERCEL_PROJECT_PRODUCTION_URL="http://localhost:3001"

# --- Launch mode ---
# Required in production. Controls pricing page and CTA behaviour.
# Must be "early_access" or "paid". Defaults to "early_access" in development.
# NEXT_PUBLIC_LAUNCH_MODE="early_access"

# --- Observability (Sentry + Better Stack) ---
# Optional, server-only public status page configuration. Set all three together.
# BETTERSTACK_API_KEY="replace-with-provider-token"
# BETTERSTACK_STATUS_PAGE_ID="replace-with-status-page-id"
# BETTERSTACK_STATUS_PAGE_URL="https://status.example.com"
# SENTRY_ORG and SENTRY_PROJECT are added by the Sentry Vercel integration.
SENTRY_ORG=""
SENTRY_PROJECT=""
# NEXT_PUBLIC_SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
