# Team Calendar database package (Prisma CLI, migrations and seed).
#
# Copy to packages/database/.env. prisma.config.ts loads it for
# `bun run migrate`, `bun run migrate:deploy`, `bun run db:push` and the seed.

# Migration owner connection string for the database you are migrating or
# seeding.
DATABASE_URL=""

# Restricted team_calendar_app connection to the same database, used for
# tenant access under row-level security. Only needed here for the local
# role provisioning script and integration tests. Leave absent, not "".
# DATABASE_APP_URL="postgresql://team_calendar_app:password@localhost:5432/team-calendar"

# Clerk Organisation the seed scopes its rows to (org_...). Set it to your real
# development organisation so the seeded tenant appears in the app. Defaults to
# the placeholder org_dev_teamcalendar when unset.
# SEED_CLERK_ORG_ID="org_xxx"
